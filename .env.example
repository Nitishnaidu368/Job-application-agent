# LLM backend for custom questions
# Recommended free/test setup: GroqCloud + Qwen 3.6 27B
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.6-27b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=30000

# Groq-specific compatibility vars
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Backward compatibility with the Anthropic path
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
RESUMES_PATH=/Users/nitishkandi/Desktop/job/Zobnest_resumes
RESUME_SOURCE_DIR=/Users/nitishkandi/Desktop/job/Zobnest_resumes
OUTPUT_DIR=./output
ZOBNEST_URL=https://www.zobnest.in/client/dashboard
LOG_LEVEL=info
HEADLESS=false
DRY_RUN=false
